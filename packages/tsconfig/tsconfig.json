{
  "compilerOptions": {
    "target": "es6",
    "lib": ["esnext", "dom", "dom.iterable"],
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "skipLibCheck": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "preserveWatchOutput": true
  }
}
